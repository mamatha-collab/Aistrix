# Copy to .env and fill in real values. Never commit the real .env.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Storage runtime: create private buckets named aistrix-input-files and aistrix-output-files.
# Apply ../supabase_app_runtime_files.sql before enabling file/document/audio/image app types in production.

# Model providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional integrations
SENTRY_DSN=
SERPAPI_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=re_xxx
EMAIL_FROM=Aistrix <noreply@yourdomain.com>

# Stripe Connect — developer payouts
STRIPE_PLATFORM_FEE_PCT=20
FRONTEND_URL=http://localhost:5173

# GitHub OAuth App (github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://your-backend.railway.app/auth/github/callback
# Secrets encryption — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Also encrypts developers' saved AI provider keys — required for Settings → Keys.
SECRET_ENCRYPTION_KEY=
# Register these events in your Stripe dashboard webhook:
#   checkout.session.completed
#   payment_intent.succeeded
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Cron / scheduled-run triggers — REQUIRED, no default. Leaving these unset
# disables the corresponding endpoint (fails closed) rather than falling back
# to a guessable value.
CRON_SECRET=
SCHEDULE_SECRET=

# Rate limits
RATE_LIMIT_PER_HOUR=30
RATE_LIMIT_PER_DAY=200
ANON_RATE_LIMIT_PER_HOUR=10

# Request/body size limits
REQUEST_TIMEOUT=180
MAX_INPUT_LENGTH=20000
MAX_SYSTEM_LENGTH=10000

# Ops failure-rate alerting — pings this webhook (Slack incoming-webhook
# payload shape: {"text": ...}) when /run's recent failure rate crosses the
# threshold. Leaving the URL unset disables alerting entirely.
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_FAILURE_THRESHOLD=0.3
OPS_ALERT_MIN_SAMPLES=10
OPS_ALERT_WINDOW_SECONDS=900
OPS_ALERT_COOLDOWN_SECONDS=1800

ENVIRONMENT=production

# Set to 1 when running behind a trusted proxy/load balancer so per-IP
# rate limits use X-Forwarded-For instead of the proxy address.
TRUST_PROXY_HEADERS=0
# Hourly runs per website visitor, per widget, for widgets with visitor access.
EMBED_VISITOR_RATE_LIMIT_PER_HOUR=20
# Data app file extraction limits (/v1/files/extract)
MAX_EXTRACT_BYTES=10485760
MAX_EXTRACT_CHARS=400000

# Developer API
BATCH_MAX_ROWS=1000
BATCH_CONCURRENCY=3
BATCH_STALE_SECONDS=180
API_MAX_CHUNKS=12

# OCR for scanned PDF pages (Data app uploads, API files, PDF URLs, agent pdf tool).
# Uses the caller's own Claude key when saved, otherwise ANTHROPIC_API_KEY.
OCR_MODEL=claude-opus-5-5
OCR_PAGES_PER_REQUEST=20
OCR_MAX_PAGES=200
OCR_CONCURRENCY=3

# Optional platform key for Google Gemini (OpenAI-compatible API). Without it,
# Gemini apps run only on developers' or users' own Gemini keys.
GEMINI_API_KEY=
# Default free runs per end user per day on apps whose developer's key pays
# (each app can set its own in "Who pays for runs").
DEV_KEY_RUNS_PER_USER_DAY=20

# Required for production: absolute SQLite path on a persistent local volume.
# Keep one persistent volume per replica across restarts. Do not use NFS or an
# ephemeral container filesystem. The default .data path is for local dev.
TELEMETRY_OUTBOX_PATH=

# Operator-only deployment details at /health/details (send as X-Ops-Token). Leave unset to disable.
OPS_HEALTH_TOKEN=

# Built-in scheduler: runs due scheduled flows and Monitor alert emails every
# N seconds on every server (work is claimed in the database, so it never runs
# twice). 0 turns it off (then call /cron/run-schedules from an outside cron).
SCHEDULER_INTERVAL_SECONDS=60
# How often Monitor alert emails are checked (each alert emails once per app per day).
MONITOR_ALERT_EMAIL_SECONDS=900

# Revenue: take over a payout claimed by a server that stopped mid-transfer
# after this long; how long one "Send owed payouts" request works; the most
# purchases read for earnings before they're reported incomplete.
PAYOUT_CLAIM_STALE_SECONDS=900
PAYOUT_BATCH_SECONDS=25
PURCHASE_ROW_LIMIT=200000

# Developer tiers (Free / Verified; limits in the developer_limits table):
# app limits, test limits, first-publish review and Basic/Standard analytics.
# 0 turns tiers off (e.g. a private deployment).
DEVELOPER_TIERS=1
# Developers always use their own AI keys (Settings → Keys); Aistrix's keys
# above serve only Aistrix's own apps and business-user features.

# Private deployment (e.g. hosted staging): only these addresses/ranges may use
# the API, comma-separated ("203.0.113.7, 198.51.100.0/24"). Empty = everyone.
# Lock the frontend at the host too (IP allowlist / access rules).
ALLOWED_CLIENT_IPS=

# The product's name and domain (emails, messages, API title). Change both to
# rename; the frontend has VITE_BRAND_NAME / VITE_BRAND_DOMAIN.
BRAND_NAME=Aistrix
BRAND_DOMAIN=aistrix.ai
