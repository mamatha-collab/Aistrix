VITE_API_URL=https://your-backend.railway.app
# Optional: the API address shown in Dev Studio's code snippets (defaults to VITE_API_URL),
# e.g. a custom domain like https://api.yourdomain.com
VITE_PUBLIC_API_URL=
VITE_SENTRY_DSN=https://xxx@sentry.io/xxx
VITE_ENVIRONMENT=production
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_POSTHOG_KEY=phc_xxx
VITE_POSTHOG_HOST=https://app.posthog.com

# The product's name and domain shown on every screen and the page title
# (same as the backend's BRAND_NAME / BRAND_DOMAIN).
VITE_BRAND_NAME=Aistrix
VITE_BRAND_DOMAIN=aistrix.ai

# Terms and Privacy Policy facts (shown in brackets until set; see src/lib/legal.js).
VITE_LEGAL_COMPANY=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_JURISDICTION=
VITE_LEGAL_DATA_REGION=
VITE_LEGAL_MINIMUM_AGE=16
