# Next.js uses NEXT_PUBLIC_* names. The migration launcher also accepts the
# legacy VITE_* equivalents; explicit NEXT_PUBLIC_* values take priority.
# Only the keys in config/public-env.mjs are mapped. Never put service-role,
# provider, Stripe secret or encryption keys in frontend configuration.
# Public values are frozen at build time: build separately for each environment.
NEXT_PUBLIC_API_URL=https://your-backend.railway.app
# Optional: the API address shown in Dev Studio's code snippets (defaults to NEXT_PUBLIC_API_URL),
# e.g. a custom domain like https://api.yourdomain.com
NEXT_PUBLIC_PUBLIC_API_URL=
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_xxx
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# The product's name and domain shown on every screen and the page title
# (same as the backend's BRAND_NAME / BRAND_DOMAIN).
NEXT_PUBLIC_BRAND_NAME=Aistrix
NEXT_PUBLIC_BRAND_DOMAIN=aistrix.ai

# Terms and Privacy Policy facts (shown in brackets until set; see src/lib/legal.js).
NEXT_PUBLIC_LEGAL_COMPANY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_JURISDICTION=
NEXT_PUBLIC_LEGAL_DATA_REGION=
NEXT_PUBLIC_LEGAL_MINIMUM_AGE=16

# "Continue with Google" on the sign-in page. Turn on (true) only after Google
# is set up in Supabase → Authentication → Providers → Google for this
# environment, with this site's address in Supabase's redirect URLs.
NEXT_PUBLIC_AUTH_GOOGLE=false
