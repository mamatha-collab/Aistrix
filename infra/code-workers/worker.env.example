# Install outside the repository as ~/.config/aistrix/code-worker.env (mode 0600).
# Separate identities/hosts for build and run workers. Never inject these
# settings or a Docker socket into customer containers.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SET_USING_HOST_SECRET_MANAGER
CODE_WORKER_DEDICATED=1
CODE_IMAGE_PREFIX=registry.example.com/aistrix-code

# Build worker only. BuildKit must be in a separate, disposable VM with
# rootless execution, bounded disk/CPU/memory and a hard VM lifetime limit.
CODE_BUILD_ISOLATION=dedicated-vm
CODE_PYTHON_BASE_IMAGE=YOUR_APPROVED_PYTHON_IMAGE@sha256:SET_VERIFIED_DIGEST
BUILDKIT_HOST=tcp://YOUR_ISOLATED_BUILDER:1234
BUILDKIT_CA=/etc/aistrix/buildkit/ca.pem
BUILDKIT_CERT=/etc/aistrix/buildkit/client.pem
BUILDKIT_KEY=/etc/aistrix/buildkit/client-key.pem

# Run worker only: rootless Docker uses this user's local socket. The
# systemd user session sets XDG_RUNTIME_DIR. Never point at a rootful or
# remote Docker daemon. Install the reaper timer before starting workers.
# DOCKER_HOST=unix:///run/user/YOUR_UID/docker.sock
